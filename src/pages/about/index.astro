---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { facets, works } from '../../lib/catalog';

const stats = [
  ['Works', works.length],
  ['Eras', facets.eras.length],
  ['Places', facets.geography.length],
  ['Materials', facets.materials.length],
];
---

<BaseLayout title="About" description="What Atrium is, where the records come from, and how the 3D works.">
  <section class="page-shell" aria-labelledby="about-title">
    <p class="eyebrow">About</p>
    <h1 id="about-title">About Atrium.</h1>
    <p class="lede">Atrium is a digital museum of sculpture. Every piece has a photograph, the facts we can confirm, and — where one has been made — a 3D model you can turn around and study.</p>
  </section>

  <section class="section" aria-labelledby="how-title">
    <div class="content-grid">
      <div class="prose">
        <h2 id="how-title">How it works</h2>
        <p>The work comes first, then the facts, then the 3D when you want a closer look. Open any piece to turn it in any direction, adjust the light, and switch on a wireframe view to see how it's built.</p>
        <p>A still photo and the full record load on every page, so nothing depends on the 3D — open it only if you want to. Where a record is missing a date, a maker, or its dimensions, we say so plainly instead of guessing.</p>

        <h2>Where the records come from</h2>
        <p>Object records come from SMK Open and related collections. The 3D models are built from scans of each sculpture, with lighter previews for quick loading.</p>
      </div>
      <aside class="aside-panel">
        <h2>The collection</h2>
        <div class="stat-grid">
          {stats.map(([label, value]) => (
            <div class="stat-card"><strong>{value}</strong><span>{label}</span></div>
          ))}
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
